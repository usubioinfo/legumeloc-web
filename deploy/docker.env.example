BIOCLUSTER_HOST=biocluster.example.edu
BIOCLUSTER_PORT=22
BIOCLUSTER_USER=cluster-service-user
BIOCLUSTER_HOST_KEY_SHA256=SHA256:replace-with-verified-fingerprint
BIOCLUSTER_KEY_FILE=/absolute/path/to/dedicated-private-key
BIOCLUSTER_REMOTE_SCRIPT=/absolute/path/to/LegumeLoc/legumeloc.sl
BIOCLUSTER_REMOTE_TMP_DIR=/absolute/path/to/prediction-jobs/legumeloc

TURNSTILE_SITE_KEY=replace-with-site-key
TURNSTILE_SECRET_KEY=replace-with-secret-key
TURNSTILE_REQUIRED=true
JOB_OWNER_HMAC_SECRET=replace-with-random-64-character-hex-secret

DOCKER_UID=1000
DOCKER_GID=1000
PUBLIC_BIND_ADDRESS=127.0.0.1
TRUSTED_PROXY_CIDR=127.0.0.1/32
NEXT_PUBLIC_BASE_PATH=/legumeloc
PREDICTION_TIMEOUT_MS=0
PREDICTION_JOB_RETENTION_MS=2592000000
PREDICTION_MAX_ACTIVE_JOBS=10
PREDICTION_MAX_ACTIVE_JOBS_PER_CLIENT=2
MAX_REQUEST_BODY_BYTES=1048576
PREDICTION_MAX_SEQUENCES=10000
PREDICTION_MAX_RESIDUES=1000000
PREDICTION_MAX_SEQUENCE_LENGTH=20000
MAX_ACCESSION_COUNT=50
MAX_ACCESSION_LENGTH=64
